---
import Layout from "../layouts/Layout.astro";
import { PAGES, SITE, href } from "../lib/site";

const dataPages = PAGES.filter((p) => ["/stureps/", "/bulletin-board/"].includes(p.path));
---

<Layout path="/">
  <hgroup>
    <h1>
      {SITE.orgName}
      <br />
      {SITE.name}
    </h1>
    <p>
      集中公告<a href={SITE.orgUrl}>本會 RPage 主網站</a>呈現彈性受限的資料。
    </p>
  </hgroup>

  <section aria-labelledby="data-heading">
    <h2 id="data-heading">提供資料</h2>
    <div class="card-grid">
      {
        dataPages.map((p) => (
          <article>
            <h3>
              <a href={href(p.path)}>{p.title}</a>
            </h3>
            <p>{p.description}</p>
          </article>
        ))
      }
    </div>
  </section>

  <section aria-labelledby="a11y-heading">
    <h2 id="a11y-heading">無障礙設計</h2>
    <p>
      本站以 WCAG 2.2 AAA
      為設計目標，提供定位點（:::）、跳到主要內容連結與亮暗模式。各區塊代號與快速鍵請見
      <a href={href("/sitemap/")}>網站導覽</a>。若遇到閱讀或操作上的困難，歡迎至{" "}
      <a href={`${SITE.repoUrl}/issues`}>GitHub 開設議題</a>來回報。
    </p>
  </section>
</Layout>
