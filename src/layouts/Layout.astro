---
import "@anyblades/blades";
import "../styles/theme.css";
import "../styles/global.css";
import Breadcrumb from "../components/Breadcrumb.astro";
import ThemeToggle from "../components/ThemeToggle.astro";
import { PAGES, SITE, absoluteUrl, getPage, href } from "../lib/site";
import { buildJsonLd, serializeJsonLd } from "../lib/jsonld";

interface Props {
  /** 在 src/lib/site.ts 的 PAGES 登記的路徑，例如 "/stureps/" */
  path: string;
}

const { path } = Astro.props;
const page = getPage(path);
const isHome = path === "/";
const fullTitle = isHome ? SITE.name : `${page.title} — ${SITE.name}`;
const jsonLd = buildJsonLd(path);
// 網站導覽固定顯示在頁首；其餘連結在寬螢幕直接列出，窄螢幕收進 dropdown。
const menuLinks = [
  ...PAGES.filter((p) => p.path !== "/" && p.path !== "/sitemap/").map((p) => ({
    label: p.title,
    href: href(p.path),
    current: p.path === path,
  })),
  { label: "回會網", href: SITE.orgUrl, current: false },
];
---

<!doctype html>
<html lang="zh-Hant-TW">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="light dark" />
    <title>{fullTitle}</title>
    <meta name="description" content={page.description} />
    {
      page.indexable ? (
        <link rel="canonical" href={absoluteUrl(path)} />
      ) : (
        <meta name="robots" content="noindex, noarchive, nosnippet" />
      )
    }

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={page.description} />
    {page.indexable && <meta property="og:url" content={absoluteUrl(path)} />}
    <meta name="twitter:card" content="summary" />

    <link rel="icon" href={SITE.icon} type="image/x-icon" />
    <link rel="apple-touch-icon" href={SITE.icon} />
    {page.indexable && <link rel="sitemap" href={href("/sitemap-index.xml")} />}

    <script is:inline>
      // 在繪製前同步決定主題，避免亮暗模式切換時閃爍（FOUC）。
      // 一律明確寫入 data-theme，之後 CSS 只需看這個屬性。
      (function () {
        var theme = null;
        try {
          theme = localStorage.getItem("theme");
        } catch (e) {}
        if (theme !== "light" && theme !== "dark") {
          theme = window.matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light";
        }
        document.documentElement.setAttribute("data-theme", theme);
      })();
    </script>

    {
      jsonLd && (
        <script type="application/ld+json" set:html={serializeJsonLd(jsonLd)} />
      )
    }
  </head>
  <body>
    <a class="skip-link" href="#C">跳到主要內容</a>

    <header class="site-header">
      <div class="container header-bar">
        <a class="landmark" id="U" href="#U" accesskey="U" title="上方功能區塊">:::</a>
        <nav aria-label="主要導覽" class="site-nav">
          <ul>
            <li>
              <a class="brand" href={href("/")} aria-current={isHome ? "page" : undefined}>
                <strong>{SITE.name}</strong>
              </a>
            </li>
          </ul>
          <ul class="nav-items">
            <li>
              <a
                href={href("/sitemap/")}
                aria-current={path === "/sitemap/" ? "page" : undefined}
              >
                網站導覽
              </a>
            </li>
            {
              menuLinks.map((l) => (
                <li class="nav-wide">
                  <a href={l.href} aria-current={l.current ? "page" : undefined}>
                    {l.label}
                  </a>
                </li>
              ))
            }
            <li class="nav-wide">
              <ThemeToggle />
            </li>
            <li class="nav-narrow">
              <details class="dropdown nav-dropdown">
                <summary>選單</summary>
                <ul>
                  {
                    menuLinks.map((l) => (
                      <li>
                        <a href={l.href} aria-current={l.current ? "page" : undefined}>
                          {l.label}
                        </a>
                      </li>
                    ))
                  }
                  <li>
                    <ThemeToggle />
                  </li>
                </ul>
              </details>
            </li>
          </ul>
        </nav>
      </div>
      <Breadcrumb path={path} />
    </header>

    <main class="container">
      <a class="landmark" id="C" href="#C" accesskey="C" title="主要內容區塊">:::</a>
      <slot />
    </main>

    <footer class="container site-footer">
      <a class="landmark" id="B" href="#B" accesskey="B" title="下方功能區塊">:::</a>
      <nav aria-label="頁尾導覽">
        <ul>
          <li><a href={SITE.orgUrl}>回會網</a></li>
          <li><a href={SITE.repoUrl}>在 GitHub 上查看原始碼</a></li>
        </ul>
      </nav>
      <p>{SITE.orgName}建置，資料來源：兩校區學生會。</p>
    </footer>

    <script>
      // dropdown 選單：原生 details 不支援 Esc 與離開焦點時關閉，這裡補上，
      // 並在 Esc 關閉後把焦點還給「選單」按鈕。
      const menu = document.querySelector<HTMLDetailsElement>("details.nav-dropdown");
      menu?.addEventListener("keydown", (e) => {
        if (e.key !== "Escape" || !menu.open) return;
        menu.open = false;
        menu.querySelector("summary")?.focus();
      });
      menu?.addEventListener("focusout", (e) => {
        const next = e.relatedTarget as Node | null;
        if (next && !menu.contains(next)) menu.open = false;
      });
    </script>
  </body>
</html>
